              "path": ["produk.php"],
              "query": [
                {
                  "key": "kategori",
                  "value": "1"
                }
              ]
            },
            "description": "Menyaring produk berdasarkan ID kategori (misal: 1 = Ayam Bangkok & Aduan)."
          }
        },
        {
          "name": "4. GET Cari Produk (?cari=bangkok)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
