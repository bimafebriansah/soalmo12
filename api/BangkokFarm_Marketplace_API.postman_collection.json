        {
          "name": "1. POST Buat Pesanan Baru (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id_user\": 2,\n  \"nama_penerima\": \"Budi Peternak\",\n  \"telepon\": \"081299887711\",\n  \"alamat_kirim\": \"Jl. Kenangan No. 10, Bandung (Ambil via KIB Stasiun Bandung Kota)\",\n  \"items\": [\n    {\n      \"id_produk\": 1,\n      \"qty\": 1\n    },\n    {\n      \"id_produk\": 10,\n      \"qty\": 2\n    }\n  ]\n}"
