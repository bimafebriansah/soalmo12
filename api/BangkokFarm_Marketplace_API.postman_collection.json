            "url": {
              "raw": "{{base_url}}/pesanan.php",
              "host": ["{{base_url}}"],
              "path": ["pesanan.php"]
            },
            "description": "Membuat pesanan baru dan otomatis mengurangi stok produk secara transaksional."
