  "item": [
    {
      "name": "Produk",
      "item": [
        {
          "name": "1. GET Semua Produk",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/produk.php",
              "host": ["{{base_url}}"],
              "path": ["produk.php"]
            },
            "description": "Mengambil seluruh daftar produk ayam, bibit DOC, dan pakan/jamu."
          }
        },
        {
          "name": "2. GET Detail Produk by ID (?id=1)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/produk.php?id=1",
              "host": ["{{base_url}}"],
              "path": ["produk.php"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Mengambil detail spesifik satu produk ayam berdasarkan ID."
          }
        },
        {
          "name": "3. GET Filter Produk by Kategori (?kategori=1)",
